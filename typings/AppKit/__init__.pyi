from __future__ import annotations

from typing import Any

class NSLocale:
    @classmethod
    def currentLocale(cls) -> Any: ...

class NSSound:
    @classmethod
    def alloc(cls) -> NSSound: ...
    def initWithContentsOfFile_byReference_(self, url: str, byref: bool) -> None: ...
    def play(self) -> None: ...

class NSWorkspace:
    @classmethod
    def sharedWorkspace(cls) -> Any: ...
    def activateFileViewerSelectingURLs_(self, urls: list[Any]) -> None: ...

class NSDockTile:
    def setBadgeLabel_(self, label: str | None) -> None: ...

class NSApplication:
    @classmethod
    def sharedApplication(cls) -> NSApplication: ...
    def dockTile(self) -> NSDockTile: ...
    def hide_(self, sender: object | None) -> None: ...
    def unhide_(self, sender: object | None) -> None: ...
