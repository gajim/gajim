from __future__ import annotations

from typing import Any
from typing import Self

class NSURL:
    @classmethod
    def fileURLWithPath_(cls, path: str) -> Any: ...

class NSObject:
    @classmethod
    def alloc(cls) -> Self: ...
    def init(self) -> Self: ...

NSURLQuarantinePropertiesKey: str

class NSUserDefaults:
    @classmethod
    def standardUserDefaults(cls) -> NSUserDefaults: ...
    def stringForKey_(self, key: str) -> str | None: ...

def NSMakeRect(x: float, y: float, width: float, height: float) -> Any: ...
def NSIntersectsRect(rect1: Any, rect2: Any) -> bool: ...
