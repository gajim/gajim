<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <template class="UniversalSearch" parent="GtkBox">
    <property name="visible">0</property>
    <property name="hexpand">1</property>
    <style>
      <class name="bg-blur" />
    </style>
    <child>
      <object class="AdwClamp">
        <property name="hexpand">1</property>
        <property name="maximum-size">500</property>
        <child>
          <object class="GtkBox" id="_dropdown">
            <property name="valign">start</property>
            <property name="height-request">400</property>
            <style>
              <class name="card" />
              <class name="bg-blur-64" />
              <class name="p-12" />
              <class name="mt-6" />
              <class name="mb-18" />
            </style>
            <child>
              <object class="AdwStatusPage" id="_search_hint">
                <property name="description" translatable="yes">Search for chats or messages</property>
                <property name="icon-name">lucide-search-symbolic</property>
                <property name="hexpand">1</property>
                <style>
                  <class name="compact" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="_results_box">
                <property name="visible">0</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="AdwToggleGroup" id="_filter_toggle_group">
                    <property name="active-name">all</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="round" />
                    </style>
                    <child>
                      <object class="AdwToggle">
                        <property name="name">all</property>
                        <property name="label" translatable="yes">All</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwToggle">
                        <property name="name">contacts</property>
                        <property name="label" translatable="yes">Contacts</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwToggle">
                        <property name="name">group_chats</property>
                        <property name="label" translatable="yes">Group Chats</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwToggle">
                        <property name="name">actions</property>
                        <property name="label" translatable="yes">Actions</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="focusable">1</property>
                    <property name="vexpand">1</property>
                    <property name="child">
                      <object class="GtkViewport">
                        <property name="child">
                          <object class="GtkListBox" id="_results_listbox">
                            <property name="hexpand">1</property>
                            <property name="selection-mode">single</property>
                            <style>
                              <class name="bg-transparent" />
                            </style>
                            <child type="placeholder">
                              <object class="AdwStatusPage">
                                <property name="description" translatable="yes">No results.</property>
                                <property name="icon-name">lucide-search-symbolic</property>
                                <property name="hexpand">1</property>
                                <style>
                                  <class name="compact" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkListBox" id="_search_listbox">
                    <property name="hexpand">1</property>
                    <property name="selection-mode">single</property>
                    <style>
                      <class name="bg-transparent" />
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>